#!/usr/bin/env bash
# compose-role — build a role's Claude launch artifacts from YAML config.
#
# Usage: scripts/compose-role [--overlay <file>]... [--skills-dir <dir>] <role> [<out-dir>]
#
# Merges config/base.yaml, config/roles/<role>.yaml, then each overlay (e.g. a
# project's .harmonik-v3/config.yaml), in that order: maps merge deeply, later
# wins; lists concatenate, duplicates removed. A null value deletes the key.
# Skills named in `skills_remove` are dropped. settings.statusLine defaults to
# scripts/statusline (set it, or null it, to change that). Each listed skill
# is looked up in --skills-dir first (e.g. a project's .harmonik-v3/skills/;
# skipped if absent), then in skills/. Writes to <out-dir> (default
# build/roles/<role>):
#
#   role.yaml                  the merged config, for inspection
#   settings.json              .settings, for `claude --settings`
#   plugin/                    a plugin holding the role's skills, for
#                              `claude --plugin-dir`, copied from the
#                              skills folders
#
# The build goes into a temp folder beside <out-dir>, which then replaces
# <out-dir> with mv (or is dropped when <out-dir> already has the same
# content), so launches of one role never see a half-built folder.
#
# Requires yq (mikefarah, v4) and jq.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BASE="$ROOT/config/base.yaml"
ROLES_DIR="$ROOT/config/roles"
SKILLS_DIR="$ROOT/skills"

die() { echo "compose-role: $*" >&2; exit 1; }

usage="usage: compose-role [--overlay <file>]... [--skills-dir <dir>] <role> [<out-dir>]"
overlays=()
skill_dirs=("$SKILLS_DIR")
while [[ "${1:-}" == --overlay || "${1:-}" == --skills-dir ]]; do
  [[ $# -ge 2 ]] || die "$usage"
  case "$1" in
    --overlay) [[ -f "$2" ]] || die "overlay not found: $2"; overlays+=("$2") ;;
    --skills-dir) skill_dirs=("$2" "$SKILLS_DIR") ;;
  esac
  shift 2
done
role="${1:-}"
[[ -n "$role" ]] || die "$usage"
role_file="$ROLES_DIR/$role.yaml"
[[ -f "$role_file" ]] || die "unknown role '$role' (no $role_file)"
out="${2:-$ROOT/build/roles/$role}"

for tool in yq jq; do command -v "$tool" >/dev/null || die "$tool not found on PATH"; done

merged="$(yq eval-all '
  . as $doc ireduce ({}; . *+ $doc)
  | .skills = ((.skills // []) - (.skills_remove // []) | unique)
  | del(.skills_remove)
  | .settings = (.settings // {})
  | .settings.statusLine = (.settings.statusLine // {"type": "command", "command": "'"$ROOT/scripts/statusline"'"})
  | del(.. | select(. == null))
  | .role = "'"$role"'"
  | ... comments = ""
' "$BASE" "$role_file" ${overlays[@]+"${overlays[@]}"})"

# find_skill <name>: the folder of the skill, from the first skills folder
# that has it; empty if none does.
find_skill() {
  local dir
  for dir in "${skill_dirs[@]}"; do
    [[ -f "$dir/$1/SKILL.md" ]] && { echo "$dir/$1"; return; }
  done
  return 0
}

# Every listed skill must exist in a skills folder.
missing=()
while IFS= read -r skill; do
  [[ -z "$skill" ]] && continue
  [[ -n "$(find_skill "$skill")" ]] || missing+=("$skill")
done < <(yq '.skills[]' <<<"$merged")
((${#missing[@]} == 0)) || die "role '$role' lists skills not in ${skill_dirs[*]}: ${missing[*]}"

final="$out"
mkdir -p "$(dirname "$final")"
out="$(mktemp -d "$(dirname "$final")/.$(basename "$final").XXXXXX")"
trap 'rm -rf "$out"' EXIT
chmod 755 "$out"
mkdir -p "$out/plugin/.claude-plugin" "$out/plugin/skills"

printf '%s\n' "$merged" > "$out/role.yaml"
yq -o=json '.settings' <<<"$merged" | jq . > "$out/settings.json"

jq -n --arg role "$role" --arg desc "$(yq '.description // ""' <<<"$merged")" '{
  name: "keeper-role",
  version: "0.0.0",
  description: ("Skills for the keeper role \($role). \($desc)" | rtrimstr(" "))
}' > "$out/plugin/.claude-plugin/plugin.json"

while IFS= read -r skill; do
  [[ -z "$skill" ]] && continue
  # -L: copy what symlinks point to, so the build holds real files.
  cp -RL "$(find_skill "$skill")" "$out/plugin/skills/$skill"
done < <(yq '.skills[]' <<<"$merged")

# Swap the new build in. An unchanged build is dropped, so the folder that
# running agents use stays in place. If a concurrent build of the role puts
# its folder in place between the two mv calls, ours is dropped (both have
# the same content): mv then fails, or moves ours inside theirs.
if [[ -d "$final" ]] && diff -r "$out" "$final" >/dev/null 2>&1; then
  rm -rf "$out"
else
  old="$(mktemp -u "$(dirname "$final")/.$(basename "$final").old.XXXXXX")"
  mv "$final" "$old" 2>/dev/null || true
  if ! mv "$out" "$final" 2>/dev/null; then
    [[ -d "$final" ]] || die "could not move the build into $final"
    rm -rf "$out"
  fi
  rm -rf "$final/$(basename "$out")" "$old"
fi
trap - EXIT
echo "$final"
