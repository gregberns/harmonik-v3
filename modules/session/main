#!/usr/bin/env bash
# session — start and stop hk3 agents in herdr. A team is a herdr workspace
# labelled with the team label; each agent is a tab labelled with its own
# label. Every herdr call is in herdr.sh.
#
# Usage (through the router, which exports HK3_ROOT and HK3_PROJECT_DIR):
#   hk3 session start [--team <team>] --name <name> [--role <role>]
#   hk3 session stop <label>
#   hk3 session tabs
set -euo pipefail

# shellcheck source=lib/hk3.sh
source "$HK3_ROOT/lib/hk3.sh"
# shellcheck source=modules/session/herdr.sh
source "$ROOT/modules/session/herdr.sh"

usage() {
  cat <<EOF
Usage: hk3 session <command>

Commands:
  start [--team <team>] --name <name> [--role <role>]
      Start an hk3 agent in a herdr tab. With --team it joins workspace
      <prefix>-<team> as <prefix>-<team>--<name>; without, it gets its own
      workspace <prefix>-<name>.
  stop <label>
      End the agent in tab <label> (Claude exits through /exit), then close
      the tab if it is still open. Only labels with the project prefix.
  tabs
      Print the labels of the open tabs with the project prefix, one per
      line. A tab may have no agent (e.g. after a herdr server restart).

All agents run in herdr session \$HK3_HERDR_SESSION (now $HK3_HERDR_SESSION).
View them with: $(view_hint)
EOF
}

# herdr session that holds every agent.
: "${HK3_HERDR_SESSION:=hk3}"
export HK3_HERDR_SESSION

# Seconds stop waits for the tab to close after /exit before an extra Enter
# (Claude's "Background work is running" dialog), then before closing it.
EXIT_WAIT=2
GRACE=5
# Seconds start waits for the launch to reach claude or fail.
LAUNCH_WAIT=30
# Seconds start then waits for claude failing right after it started.
SETTLE=2

# The clean environment: variables that must never reach an agent from the
# caller (Claude's own, and the caller's hk3/keeper identity). Removed when
# the herdr server starts and again in the typed launch command.
SCRUB_RE='^(CLAUDECODE|CLAUDE_CODE_.*|CLAUDE_PID|CLAUDE_EFFORT|HK3_.*|KEEPER_.*|HARMONIK_AGENT)$'
# Settings the launch sets per agent; never passed on from the caller.
PER_AGENT_RE='^(HK3_AGENT_NAME|HK3_AGENT_ID|HK3_TEAM|HK3_ROLE|HK3_ROOT|KEEPER_ENABLED)$'

# The typed launch runs in the pane's own shell (any shell that knows '...'
# and &&): bash removes the scrub list, exports the settings given before --,
# and runs the rest. A failed launch prints a line start waits for.
LAUNCH_SCRIPT='re=$1; shift; for v in $(compgen -e); do [[ $v =~ $re ]] && unset "$v"; done; while [[ $1 != -- ]]; do export "$1"; shift; done; shift; "$@" || { rc=$?; echo "hk3: launch failed (exit $rc)" >&2; exit $rc; }'
# Output start waits for: the launcher's last line before it runs claude
# (harmonik-v3 prints "hk3: claude ..."), or the failure line.
FAIL_RE='^hk3: launch failed \(exit [0-9]+\)'
LAUNCH_RE='^hk3: (claude |launch failed \(exit [0-9]+\))'

# quote <word>: <word> in single quotes, for any POSIX-like shell.
quote() {
  local rest="$1" out=""
  while [[ "$rest" == *"'"* ]]; do
    out+="${rest%%"'"*}'\\''"
    rest="${rest#*"'"}"
  done
  printf "'%s'" "$out$rest"
}

# unset_args: env -u arguments for every scrub-list variable now set.
unset_args() {
  local name
  for name in $(compgen -e); do
    [[ "$name" =~ $SCRUB_RE ]] && printf '%s\n' -u "$name"
  done
  return 0
}

# launch_command <hk3 args...>: the command typed into a tab: the clean
# environment, the resolved settings, the hk3 script by absolute path, and
# && exit so the tab closes when Claude exits normally.
launch_command() {
  local cmd name
  cmd="/bin/bash -c $(quote "$LAUNCH_SCRIPT") hk3-launch $(quote "$SCRUB_RE")"
  for name in $(compgen -e | grep -E '^(HK3|KEEPER)_' | sort); do
    [[ "$name" =~ $PER_AGENT_RE ]] && continue
    cmd+=" $(quote "$name=${!name}")"
  done
  cmd+=" -- $(quote "$ROOT/harmonik-v3")"
  for name in "$@"; do cmd+=" $(quote "$name")"; done
  printf '%s && exit' "$cmd"
}

require_prefix() {
  [[ -n "${HK3_PROJECT_PREFIX:-}" ]] ||
    die "session commands need a project prefix: set HK3_PROJECT_PREFIX in $PROJECT_CONF/config.env"
  check_part HK3_PROJECT_PREFIX "$HK3_PROJECT_PREFIX"
}

# lock / unlock: one start at a time per herdr session, across projects and
# callers (an agent's TMPDIR can differ from the operator's, so not TMPDIR).
LOCK="/tmp/hk3-$(id -u)-session-$HK3_HERDR_SESSION.lock"
lock() {
  local i
  for i in $(seq 1 100); do
    if mkdir "$LOCK" 2>/dev/null; then
      trap unlock EXIT
      return 0
    fi
    sleep 0.1
  done
  die "another session start holds $LOCK; if none is running, remove it"
}
unlock() {
  rmdir "$LOCK" 2>/dev/null || true
  trap - EXIT
}

cmd_start() {
  local team="" name="" role=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --team) [[ $# -ge 2 && -n "$2" ]] || die "--team needs a value"; team="$2"; shift 2 ;;
      --name) [[ $# -ge 2 && -n "$2" ]] || die "--name needs a value"; name="$2"; shift 2 ;;
      --role) [[ $# -ge 2 && -n "$2" ]] || die "--role needs a value"; role="$2"; shift 2 ;;
      *) die "unknown argument: $1 (usage: hk3 session start [--team <team>] --name <name> [--role <role>])" ;;
    esac
  done
  [[ -n "$name" ]] || die "session start needs --name <name>"
  check_part --name "$name"
  local args=(new agent claude) label team_label
  if [[ -n "$team" ]]; then
    check_part --team "$team"
    label="$(agent_label "$(member_name "$team" "$name")")"
    team_label="$(agent_label "$team")"
    args+=(--team "$team")
  else
    label="$(agent_label "$name")"
    team_label="$label"
  fi
  args+=(--name "$name")
  [[ -n "$role" ]] && args+=(--role "$role")

  # shellcheck disable=SC2046
  ensure_server env $(unset_args)
  # Starts at the same moment must not both pass the label check or both
  # create the team's workspace.
  lock
  tab_exists "$label" &&
    die "$label already has a tab in herdr session $HK3_HERDR_SESSION (stop it first: hk3 session stop $label)"
  open_tab "$team_label" "$label" "$PROJECT_DIR" || die "could not open a tab for $label"
  unlock
  type_line "$label" "$(launch_command "${args[@]}")" || die "could not type the launch into $label"

  local line
  if ! line="$(wait_output "$label" "$LAUNCH_RE" "$LAUNCH_WAIT")"; then
    tab_exists "$label" || die "$label: its tab closed right after the launch"
    die "$label: no launch output within ${LAUNCH_WAIT}s; see its tab ($(view_hint))"
  fi
  if [[ "$line" != *"launch failed"* ]]; then
    # claude itself can fail right after the launcher's last line.
    line="$(wait_output "$label" "$FAIL_RE" "$SETTLE")" || line=""
    tab_exists "$label" || die "$label: its tab closed right after the launch"
  fi
  [[ -z "$line" ]] ||
    die "$label: ${line#hk3: }; its tab stays open with the error ($(view_hint))"
  echo "hk3: started $label in herdr session $HK3_HERDR_SESSION, workspace $team_label"
}

# wait_closed <label> <seconds>: wait until the tab is gone.
wait_closed() {
  local i
  for i in $(seq 1 $(($2 * 4))); do
    tab_exists "$1" || return 0
    sleep 0.25
  done
  ! tab_exists "$1"
}

cmd_stop() {
  [[ $# -eq 1 && -n "$1" ]] || die "usage: hk3 session stop <label>"
  local label="$1"
  [[ "$label" == "$HK3_PROJECT_PREFIX"-* ]] ||
    die "$label does not have the project prefix $HK3_PROJECT_PREFIX; hk3 stops only its own tabs"
  if ! tab_exists "$label"; then
    echo "hk3: no tab $label in herdr session $HK3_HERDR_SESSION; nothing to stop" >&2
    return 0
  fi
  # ctrl+c clears a draft of any length and interrupts a running turn; then
  # /exit lets Claude end normally, so SessionEnd hooks run.
  send_keys "$label" ctrl+c || true
  sleep 0.3
  type_line "$label" /exit || true
  if ! wait_closed "$label" "$EXIT_WAIT"; then
    send_keys "$label" enter || true
    if ! wait_closed "$label" "$GRACE"; then
      echo "hk3: $label still open after /exit; closing its tab" >&2
      close_tab "$label" || die "could not close the tab of $label"
    fi
  fi
  echo "hk3: stopped $label"
}

# cmd_tabs: the open tabs with the project prefix.
cmd_tabs() {
  tab_labels | grep -E "^$HK3_PROJECT_PREFIX-" || true
}

case "${1:-}" in
  start) shift; require_prefix; cmd_start "$@" ;;
  stop) shift; require_prefix; cmd_stop "$@" ;;
  tabs) shift; [[ $# -eq 0 ]] || die "usage: hk3 session tabs"; require_prefix; cmd_tabs ;;
  -h|--help|help) usage ;;
  *) usage >&2; exit 1 ;;
esac
