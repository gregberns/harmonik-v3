#!/usr/bin/env bash
# crew — teams of hk3 agents: start a team from a crew definition, add and
# stop members, and the roster that lists them. Agents start and stop only
# through `hk3 session`; this module never calls herdr.
#
# Usage (through the router, which exports HK3_ROOT and HK3_PROJECT_DIR):
#   hk3 crew start <crew> [--team <team>]
#   hk3 crew add <role> [--name <member>] [--responsibility <text>] [--team <team>]
#   hk3 crew roster [--team <team>]
#   hk3 crew stop <member>... | --all [--team <team>]
#
# Identity (lib/hk3.sh): inside an hk3 session (HK3_AGENT_ID set) the team is
# always the caller's; outside one --team is required.
set -euo pipefail

# shellcheck source=lib/hk3.sh
source "$HK3_ROOT/lib/hk3.sh"

HK3="$ROOT/harmonik-v3"
TEAMS_DIR="$PROJECT_CONF/teams"
# Crew definitions and workflows: the project's folder first, then hk3's.
CREW_DIRS=("$PROJECT_CONF/crews" "$ROOT/crews")
WORKFLOW_DIRS=("$PROJECT_CONF/workflows" "$ROOT/workflows")
# Seconds add and stop wait for another crew command on the same team.
LOCK_WAIT=120

usage() {
  cat <<EOF
Usage: hk3 crew <command>

Commands:
  start <crew> [--team <team>]
      Start a team from a crew definition: <crew> is a name, looked up in
      $PROJECT_CONF/crews/ then $ROOT/crews/, or a path
      to a .yaml file. The first member is the lead and takes the team label
      (<prefix>-<team>); the others are <prefix>-<team>--<member>. Inside
      an hk3 session the team is yours and you fill the lead slot (only
      the team label agent, not a member, may do this); outside
      one, --team is required. Refused if the team has a roster or a label
      is already a live tab. The workflow it names is looked up in
      $PROJECT_CONF/workflows/ then $ROOT/workflows/.
  add <role> [--name <member>] [--responsibility <text>] [--team <team>]
      Add a member to the team and start it (hk3 session start). The name
      defaults to the role, with the next free number when taken (builder,
      builder-2, ...); a taken --name is refused. The responsibility (one line) defaults to
      the role's description. Inside an hk3 session the team is yours, and
      the first add makes you its first member; outside one, --team is
      required.
  roster [--team <team>]
      Print the team's roster, which members have a live herdr tab, and,
      inside an hk3 session, your own label.
  stop <member>... | --all [--team <team>]
      Stop members (hk3 session stop) and remove them from the roster, also
      when they have no tab. --all stops every member but you; from outside
      a session it stops all and deletes the roster.

Rosters live in $TEAMS_DIR/<team>.yaml.
EOF
}

# --- Identity -------------------------------------------------------------------

# in_session: true inside an hk3 session.
in_session() { [[ -n "${HK3_AGENT_ID:-}" ]]; }

# resolve_team <--team value or empty>: set TEAM, TEAM_LABEL and ROSTER.
# Inside a session the team is the caller's, --team may only repeat it, and
# the team label is the part of HK3_AGENT_ID before -- (team_label); it must
# match what the current prefix gives, or members would be started under
# another label than the roster's.
resolve_team() {
  local given="$1"
  if in_session; then
    TEAM="$(caller_team)"
    [[ -n "$TEAM" ]] || die "you are an hk3 agent without a name ($HK3_AGENT_ID); crew commands need a named agent"
    [[ -z "$given" || "$given" == "$TEAM" ]] ||
      die "you are on team $TEAM; crew commands from inside a session work only on your own team"
  else
    [[ -n "$given" ]] || die "outside an hk3 session, pass --team <team>"
    TEAM="$given"
  fi
  check_part team "$TEAM"
  TEAM_LABEL="$(agent_label "$TEAM")"
  if in_session; then
    local own
    own="$(team_label)"
    [[ "$own" == "$TEAM_LABEL" ]] ||
      die "your team label is $own (from HK3_AGENT_ID) but the project prefix gives $TEAM_LABEL; check HK3_PROJECT_PREFIX"
  fi
  ROSTER="$TEAMS_DIR/$TEAM.yaml"
}

# --- Roster ---------------------------------------------------------------------
# <team>.yaml: team, label (the team label), from crew start also crew and
# workflow (name, path), and members (label, role, responsibility).
# Rewritten whole on every change, under the team's lock.

# ensure_teams_dir: the teams folder, kept out of git.
ensure_teams_dir() {
  mkdir -p "$TEAMS_DIR"
  [[ -f "$TEAMS_DIR/.gitignore" ]] || echo '*' > "$TEAMS_DIR/.gitignore"
}

# lock / unlock: one add or stop at a time per team, so two adds never pick
# the same name and no write drops another's change.
LOCK=""
lock() {
  LOCK="$TEAMS_DIR/$TEAM.lock"
  local i
  for i in $(seq 1 $((LOCK_WAIT * 10))); do
    if mkdir "$LOCK" 2>/dev/null; then
      trap unlock EXIT
      return 0
    fi
    sleep 0.1
  done
  die "another crew command holds $LOCK; if none is running, remove it"
}
unlock() {
  [[ -n "$LOCK" ]] && rmdir "$LOCK" 2>/dev/null || true
  LOCK=""
  trap - EXIT
}

# roster_labels: the member labels on the roster, one per line.
roster_labels() {
  yq -r '.members[].label' "$ROSTER"
}

# roster_write <yq expression>: apply the expression to the roster (or to an
# empty document if there is none yet) and replace the file.
roster_write() {
  local tmp="$ROSTER.tmp.$$"
  if [[ -f "$ROSTER" ]]; then
    yq "$1" "$ROSTER" > "$tmp"
  else
    yq -n "$1" > "$tmp"
  fi
  mv "$tmp" "$ROSTER"
}

# roster_add <label> <role> <responsibility>
roster_add() {
  L="$1" R="$2" S="$3" T="$TEAM" TL="$TEAM_LABEL" roster_write \
    '.team = strenv(T) | .label = strenv(TL) | .members += [{"label": strenv(L), "role": strenv(R), "responsibility": strenv(S)}]'
}

# roster_remove <label>
roster_remove() {
  L="$1" roster_write 'del(.members[] | select(.label == strenv(L)))'
}

# --- Roles ----------------------------------------------------------------------

role_file() { echo "$ROOT/config/roles/$1.yaml"; }

# check_role <role> [<message prefix>]
check_role() {
  [[ "$1" =~ ^[A-Za-z0-9_-]+$ && -f "$(role_file "$1")" ]] ||
    die "${2:-}unknown role: $1 (hk3 list roles)"
}

role_description() {
  yq -r '.description // ""' "$(role_file "$1")"
}

# live_tabs: the labels of this project's open herdr tabs.
live_tabs() {
  "$HK3" session tabs
}

# first_prompt <label> <role>: the member's one-line first prompt.
first_prompt() {
  echo "You are $1, role $2, on team $TEAM (team label $TEAM_LABEL). Run \`hk3 crew roster\` to see your team."
}

# --- Crew definitions and workflows ---------------------------------------------
# Structural checks only: hk3 never interprets a workflow, and a definition
# says only who starts.

# find_named <kind> <name> <dir>...: the first <dir>/<name>.yaml.
find_named() {
  local kind="$1" name="$2" dir
  shift 2
  [[ "$name" =~ ^[A-Za-z0-9_-]+$ ]] || die "bad $kind name: $name"
  for dir in "$@"; do
    [[ -f "$dir/$name.yaml" ]] && { echo "$dir/$name.yaml"; return 0; }
  done
  die "no $kind named $name (looked for $name.yaml in: $*)"
}

# yaml_json <file>: the file as JSON, or die if it is not one YAML document.
yaml_json() {
  [[ -f "$1" && -r "$1" ]] || die "no such file: $1"
  local json
  json="$(yq -o=json '.' "$1" 2>/dev/null)" || die "$1 is not valid YAML"
  [[ "$(jq -s length <<<"$json")" == 1 ]] || die "$1 must hold exactly one YAML document"
  echo "$json"
}

# The definition's first error, or nothing.
DEF_CHECK='
def one_line: type == "string" and (test("[\n\r\u001f]") | not);
def member_error($i):
  "member \($i + 1)" as $m
  | if type != "object" then "\($m) is not a mapping"
    elif (.role | type) != "string" or .role == "" then "\($m) needs a role"
    elif has("name") and ((.name | type) != "string" or .name == "") then "\($m): name must be text"
    elif has("count") and ((.count | type) != "number" or .count != (.count | floor) or .count < 1) then "\($m): count must be a whole number of at least 1"
    elif has("responsibility") and ((.responsibility | one_line) | not) then "\($m): responsibility must be one line of text"
    elif $i == 0 and (has("name") or (has("count") and .count != 1)) then "member 1 is the lead: it takes the team label, so it has no name, and no count other than 1"
    else empty end;
if type != "object" then "is not a YAML mapping"
elif (.description | type) != "string" or .description == "" then "needs a description"
elif has("workflow") and ((.workflow | type) != "string" or .workflow == "") then "workflow must be a workflow name"
elif (.members | type) != "array" or (.members | length) == 0 then "needs a members list"
else [.members | to_entries[] | .key as $i | .value | member_error($i)] | .[0] // empty
end'

# One line per resulting member: role, name (empty for the lead), 1 if the
# definition gives a responsibility, and the responsibility; separated by \x1f.
DEF_MEMBERS='
.members | to_entries[] | .key as $i | .value
| (.name // .role) as $base
| range(1; (.count // 1) + 1) as $n
| [.role, (if $i == 0 then "" elif $n == 1 then $base else "\($base)-\($n)" end),
   (if has("responsibility") then "1" else "0" end), (.responsibility // "")]
| join("\u001f")'

# load_crew <name or path>: check the definition and its workflow and set
# CREW_NAME, CREW_FILE, WORKFLOW_NAME, WORKFLOW_FILE (empty without one) and,
# per resulting member (the lead first), M_ROLE, M_NAME, M_HAS_RESP, M_RESP.
load_crew() {
  if [[ "$1" == */* || "$1" == *.yaml || "$1" == *.yml ]]; then
    CREW_FILE="$1"
  else
    CREW_FILE="$(find_named "crew definition" "$1" "${CREW_DIRS[@]}")"
  fi
  CREW_NAME="$(basename "$CREW_FILE")"
  CREW_NAME="${CREW_NAME%.y*ml}"
  local json err
  json="$(yaml_json "$CREW_FILE")"
  err="$(jq -r "$DEF_CHECK" <<<"$json")"
  [[ -z "$err" ]] || die "crew definition $CREW_FILE: $err"

  M_ROLE=() M_NAME=() M_HAS_RESP=() M_RESP=()
  local role name has resp
  while IFS=$'\x1f' read -r role name has resp; do
    M_ROLE+=("$role") M_NAME+=("$name") M_HAS_RESP+=("$has") M_RESP+=("$resp")
  done < <(jq -r "$DEF_MEMBERS" <<<"$json")
  local i seen=" "
  for i in "${!M_ROLE[@]}"; do
    check_role "${M_ROLE[$i]}" "crew definition $CREW_FILE: "
    [[ "$i" == 0 ]] && continue
    [[ -n "${M_NAME[$i]}" ]] || die "crew definition $CREW_FILE: member $((i + 1)) has an empty name"
    check_part "member name in $CREW_FILE" "${M_NAME[$i]}"
    [[ "$seen" != *" ${M_NAME[$i]} "* ]] ||
      die "crew definition $CREW_FILE: two members are named ${M_NAME[$i]} (give one a name, or use count)"
    seen+="${M_NAME[$i]} "
  done

  WORKFLOW_NAME="$(jq -r '.workflow // ""' <<<"$json")"
  WORKFLOW_FILE=""
  [[ -n "$WORKFLOW_NAME" ]] || return 0
  WORKFLOW_FILE="$(find_named workflow "$WORKFLOW_NAME" "${WORKFLOW_DIRS[@]}")"
  json="$(yaml_json "$WORKFLOW_FILE")"
  jq -e 'type == "object" and (.description | type) == "string" and .description != ""' <<<"$json" >/dev/null ||
    die "workflow $WORKFLOW_FILE needs a description"
}

# roster_create <lead label> <lead role> <lead responsibility>: the roster of
# a team started from a definition, with every member, written before any
# starts so each member's first look finds the whole team.
roster_create() {
  local members i label resp
  members="$(jq -n --arg l "$1" --arg r "$2" --arg s "$3" '[{label: $l, role: $r, responsibility: $s}]')"
  for i in "${!M_ROLE[@]}"; do
    [[ "$i" == 0 ]] && continue
    label="$TEAM_LABEL--${M_NAME[$i]}"
    resp="${M_RESP[$i]}"
    [[ "${M_HAS_RESP[$i]}" == 1 ]] || resp="$(role_description "${M_ROLE[$i]}")"
    members="$(jq --arg l "$label" --arg r "${M_ROLE[$i]}" --arg s "$resp" '. + [{label: $l, role: $r, responsibility: $s}]' <<<"$members")"
  done
  local tmp="$ROSTER.tmp.$$"
  jq -n --arg t "$TEAM" --arg tl "$TEAM_LABEL" --arg c "$CREW_NAME" \
    --arg wn "$WORKFLOW_NAME" --arg wp "$WORKFLOW_FILE" --argjson m "$members" \
    '{team: $t, label: $tl, crew: $c} + (if $wn == "" then {} else {workflow: {name: $wn, path: $wp}} end) + {members: $m}' |
    yq -p=json -o=yaml '.' > "$tmp"
  mv "$tmp" "$ROSTER"
}

# --- Commands -------------------------------------------------------------------

cmd_start() {
  local crew="" given_team=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --team) [[ $# -ge 2 && -n "$2" ]] || die "--team needs a value"; given_team="$2"; shift 2 ;;
      -*) die "unknown option: $1" ;;
      *) [[ -z "$crew" ]] || die "unexpected argument: $1"; crew="$1"; shift ;;
    esac
  done
  [[ -n "$crew" ]] || die "usage: hk3 crew start <crew> [--team <team>]"
  resolve_team "$given_team"
  load_crew "$crew"
  # An absolute path, so the roster points at the file from anywhere.
  [[ -z "$WORKFLOW_FILE" ]] || WORKFLOW_FILE="$(cd "$(dirname "$WORKFLOW_FILE")" && pwd)/$(basename "$WORKFLOW_FILE")"

  # Inside a session --all keeps the caller and the roster; only a stop from
  # outside deletes a stale roster.
  local stale="team $TEAM already has a roster ($ROSTER); grow it with hk3 crew add, or if it is stale clear it from outside a session with hk3 crew stop --all --team $TEAM"
  local cleanup="hk3 crew stop --all --team $TEAM"
  in_session && cleanup="hk3 crew stop --all"
  [[ ! -f "$ROSTER" ]] || die "$stale"
  # The lead is always the team label itself (spec decision 3), so from
  # inside a session only that agent can take the lead slot.
  if in_session && [[ "$HK3_AGENT_ID" != "$TEAM_LABEL" ]]; then
    die "only the team lead ($TEAM_LABEL) can start a crew from inside a session; you are $HK3_AGENT_ID. Ask the lead, or run it from outside a session with --team $TEAM"
  fi
  local tabs i label
  tabs=" $(live_tabs | tr '\n' ' ') "
  if ! in_session; then
    [[ "$tabs" != *" $TEAM_LABEL "* ]] ||
      die "$TEAM_LABEL is a live tab; to put that agent in the lead slot, run hk3 crew start $crew from inside it, or pick another team name"
  fi
  for i in "${!M_ROLE[@]}"; do
    [[ "$i" == 0 ]] && continue
    label="$TEAM_LABEL--${M_NAME[$i]}"
    [[ "$tabs" != *" $label "* ]] ||
      die "$label is a live tab; stop it first (hk3 session stop $label) or pick another team name"
  done

  # The lead slot: outside a session an agent named after the team, with the
  # slot's role; inside one the caller, under its actual role.
  local lead_label="$TEAM_LABEL" lead_role="${M_ROLE[0]}" lead_resp="${M_RESP[0]}"
  if in_session; then
    lead_label="$HK3_AGENT_ID"
    lead_role="$HK3_ROLE"
  fi
  [[ "${M_HAS_RESP[0]}" == 1 ]] || lead_resp="$(role_description "$lead_role" 2>/dev/null || true)"

  ensure_teams_dir
  lock
  [[ ! -f "$ROSTER" ]] || die "$stale"
  roster_create "$lead_label" "$lead_role" "$lead_resp"

  local started=() args
  for i in "${!M_ROLE[@]}"; do
    if [[ "$i" == 0 ]]; then
      in_session && continue
      label="$TEAM_LABEL"
      args=(--name "$TEAM")
    else
      label="$TEAM_LABEL--${M_NAME[$i]}"
      args=(--team "$TEAM" --name "${M_NAME[$i]}")
    fi
    if ! "$HK3" session start "${args[@]}" --role "${M_ROLE[$i]}" \
      --prompt "$(first_prompt "$label" "${M_ROLE[$i]}")"; then
      echo "hk3: $label did not start; crew start stopped there" >&2
      echo "hk3: started: ${started[*]:-none}" >&2
      local j rest=()
      for j in "${!M_ROLE[@]}"; do [[ "$j" -gt "$i" ]] && rest+=("$TEAM_LABEL--${M_NAME[$j]}"); done
      echo "hk3: not started: $label${rest[*]:+ ${rest[*]}}" >&2
      die "every member of crew $CREW_NAME is on the roster of team $TEAM; clean up with: $cleanup"
    fi
    started+=("$label")
  done
  unlock
  echo "hk3: started team $TEAM from crew $CREW_NAME: ${started[*]:-nobody}${WORKFLOW_FILE:+; workflow $WORKFLOW_NAME ($WORKFLOW_FILE)}"
}

cmd_add() {
  local role="" name="" resp="" given_team=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name) [[ $# -ge 2 && -n "$2" ]] || die "--name needs a value"; name="$2"; shift 2 ;;
      --responsibility) [[ $# -ge 2 ]] || die "--responsibility needs a value"; resp="$2"; shift 2 ;;
      --team) [[ $# -ge 2 && -n "$2" ]] || die "--team needs a value"; given_team="$2"; shift 2 ;;
      -*) die "unknown option: $1" ;;
      *) [[ -z "$role" ]] || die "unexpected argument: $1"; role="$1"; shift ;;
    esac
  done
  [[ -n "$role" ]] || die "usage: hk3 crew add <role> [--name <member>] [--responsibility <text>] [--team <team>]"
  check_role "$role"
  [[ "$resp" != *[$'\n\r']* ]] || die "--responsibility must be one line"
  [[ -n "$name" ]] && check_part --name "$name"
  resolve_team "$given_team"
  [[ -n "$resp" ]] || resp="$(role_description "$role")"

  ensure_teams_dir
  lock
  # The first add from a solo agent makes it the team's first member, under
  # its actual role.
  if [[ ! -f "$ROSTER" ]] && in_session; then
    roster_add "$HK3_AGENT_ID" "$HK3_ROLE" "$(role_description "$HK3_ROLE" 2>/dev/null || true)"
  fi
  # Taken: names on the roster and tabs of this team (a tab may be stale).
  local taken=() label
  while IFS= read -r label; do
    [[ "$label" == "$TEAM_LABEL--"* ]] && taken+=("${label#"$TEAM_LABEL--"}")
  done < <({ [[ -f "$ROSTER" ]] && roster_labels; live_tabs; } || true)
  if [[ -n "$name" ]]; then
    [[ " ${taken[*]-} " != *" $name "* ]] ||
      die "$TEAM_LABEL--$name is taken (on the roster or a live tab; hk3 crew roster)"
  else
    name="$(next_free_name "$role" ${taken[@]+"${taken[@]}"})"
  fi
  label="$TEAM_LABEL--$name"
  # Written before the start, so the member's first look at the roster
  # finds itself.
  roster_add "$label" "$role" "$resp"
  if ! "$HK3" session start --team "$TEAM" --name "$name" --role "$role" \
    --prompt "$(first_prompt "$label" "$role")"; then
    die "$label is on the roster of team $TEAM but did not start; remove it with: hk3 crew stop $name${given_team:+ --team $TEAM}"
  fi
  unlock
  echo "hk3: added $label ($role) to team $TEAM"
}

cmd_roster() {
  local given_team=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --team) [[ $# -ge 2 && -n "$2" ]] || die "--team needs a value"; given_team="$2"; shift 2 ;;
      *) die "usage: hk3 crew roster [--team <team>]" ;;
    esac
  done
  resolve_team "$given_team"
  in_session && echo "You are $HK3_AGENT_ID."
  [[ -f "$ROSTER" ]] || die "team $TEAM has no roster ($ROSTER)"
  local tabs
  tabs=" $(live_tabs | tr '\n' ' ') "
  echo "Team $TEAM (team label $TEAM_LABEL), roster $ROSTER"
  yq -r 'select(.crew) | "Crew: " + .crew' "$ROSTER"
  yq -r 'select(.workflow) | "Workflow: " + .workflow.name + ", " + .workflow.path' "$ROSTER"
  echo "Members (label, role, live herdr tab, responsibility):"
  local label role resp live
  while IFS=$'\t' read -r label role resp; do
    live="not live"
    [[ "$tabs" == *" $label "* ]] && live="live"
    printf '  %s\t%s\t%s\t%s\n' "$label" "$role" "$live" "$resp"
  done < <(yq -r '.members[] | .label + "\t" + .role + "\t" + .responsibility' "$ROSTER")
}

# stop_member <label> <tabs>: stop the member's tab, if it has one, and take
# it off the roster. A member without a tab is only taken off (it may run in
# a plain terminal, which the operator closes by hand).
stop_member() {
  if [[ "$2" == *" $1 "* ]]; then
    "$HK3" session stop "$1" || { echo "hk3: could not stop $1; it stays on the roster" >&2; return 1; }
  else
    echo "hk3: $1 has no herdr tab; taking it off the roster (if it runs in a plain terminal, close it by hand)" >&2
  fi
  lock
  roster_remove "$1"
  unlock
}

cmd_stop() {
  local all="" given_team="" names=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --all) all=1; shift ;;
      --team) [[ $# -ge 2 && -n "$2" ]] || die "--team needs a value"; given_team="$2"; shift 2 ;;
      -*) die "unknown option: $1" ;;
      *) names+=("$1"); shift ;;
    esac
  done
  [[ -n "$all" || ${#names[@]} -gt 0 ]] ||
    die "name the members to stop, or pass --all (usage: hk3 crew stop <member>... | --all [--team <team>])"
  [[ -z "$all" || ${#names[@]} -eq 0 ]] || die "pass member names or --all, not both"
  resolve_team "$given_team"
  if [[ ! -f "$ROSTER" ]]; then
    [[ -n "$all" ]] && { echo "hk3: team $TEAM has no roster; nothing to stop" >&2; return 0; }
    die "team $TEAM has no roster ($ROSTER)"
  fi

  local on=" $(roster_labels | tr '\n' ' ') " labels=() n label
  if [[ -n "$all" ]]; then
    while IFS= read -r label; do
      in_session && [[ "$label" == "$HK3_AGENT_ID" ]] && continue
      labels+=("$label")
    done < <(roster_labels)
  else
    # A member is named by its member name (tester) or its full label.
    for n in "${names[@]}"; do
      label="$TEAM_LABEL--$n"
      [[ "$on" == *" $n "* ]] && label="$n"
      [[ "$on" == *" $label "* ]] || die "$n is not on the roster of team $TEAM (hk3 crew roster)"
      ! in_session || [[ "$label" != "$HK3_AGENT_ID" ]] ||
        die "you cannot stop yourself ($label); end your own session with /exit"
      labels+=("$label")
    done
  fi

  local tabs failed=0
  tabs=" $(live_tabs | tr '\n' ' ') "
  for label in ${labels[@]+"${labels[@]}"}; do
    stop_member "$label" "$tabs" || failed=1
  done
  [[ "$failed" == 0 ]] || die "some members did not stop; they stay on the roster"
  if [[ -n "$all" ]] && ! in_session; then
    # Re-read under the lock: a member added while this stop ran stays, and
    # so does its roster.
    lock
    local left
    left="$(roster_labels | tr '\n' ' ')"
    if [[ -z "${left// /}" ]]; then
      rm -f "$ROSTER"
      unlock
      echo "hk3: team $TEAM stopped; roster deleted"
    else
      unlock
      die "members were added while stopping and are still on the roster: ${left% }; run hk3 crew stop --all --team $TEAM again"
    fi
  fi
}

case "${1:-}" in
  start) shift; require_prefix crew; cmd_start "$@" ;;
  add) shift; require_prefix crew; cmd_add "$@" ;;
  roster) shift; require_prefix crew; cmd_roster "$@" ;;
  stop) shift; require_prefix crew; cmd_stop "$@" ;;
  -h|--help|help) usage ;;
  *) usage >&2; exit 1 ;;
esac
